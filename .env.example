# SAGAR — Seafloor Analysis and Geospatial Assessment for Resource Exploration
# Server-side Gemini AI Configuration

# Add your Gemini API key below to enable live Google Gemini analysis
# If left empty, SAGAR automatically operates using the local deterministic oceanographic interpretation engine.
GEMINI_API_KEY=

# Supported models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
